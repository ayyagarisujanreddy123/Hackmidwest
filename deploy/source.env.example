# Proposed EC2 paths only. Contains no credentials; do not source on the working Mac.
AWS_REGION=us-east-2
STRANDS_MODEL_ID=us.amazon.nova-micro-v1:0
CONTEXTFORGE_ENABLE_WORKFLOW=1
CONTEXTFORGE_SOURCE_URL=http://127.0.0.1:8001
CONTEXTFORGE_ALLOWED_SOURCE_HOSTS=127.0.0.1
CONTEXTFORGE_CONTRACT_PATH=/opt/contextforge/contextforge_mcp_starter/demo/source_contract.json
CONTEXTFORGE_VALIDATION_CASES_PATH=/opt/contextforge/contextforge_mcp_starter/demo/validation_cases.json
CONTEXTFORGE_DB=/var/lib/contextforge/capabilities.sqlite3
